# Pooled connection (app runtime)
DATABASE_URL=postgresql://user:password@host-pooler/dbname?sslmode=require
# Direct connection (migrations)
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
# Better Auth (secret: 32+ random chars, e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=replace-with-a-random-string-of-32-plus-chars
BETTER_AUTH_URL=http://localhost:3000
